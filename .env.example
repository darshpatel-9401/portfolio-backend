# Copy to .env and fill in. NEVER commit .env
MONGO_URI=mongodb://localhost:27017
MONGO_DB=portfolio_cms
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Addresses of your portfolio site and admin panel (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Contact form email (optional). If SMTP_HOST is empty the message is only saved in MongoDB.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_RECEIVER=

# Only used by `python seed.py` the first time. CHANGE THE PASSWORD AFTER LOGIN.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
